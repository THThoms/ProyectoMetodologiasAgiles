# =============================================================================
# ServiceDesk UTA - Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (una sola instancia, 3 bases aisladas: auth_db, catalog_db, ticket_db)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_root_change_me

# Cada microservicio recibe credenciales solo de su propia base
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass_change_me

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass_change_me

TICKET_DB_NAME=ticket_db
TICKET_DB_USER=ticket_user
TICKET_DB_PASSWORD=ticket_pass_change_me

# URLs opcionales para scripts administrativos del ticket-service que necesitan
# leer datos reales de auth_db y catalog_db sin usar IDs quemados.
AUTH_DATABASE_URL=postgresql://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${AUTH_DB_NAME}?schema=public
CATALOG_DATABASE_URL=postgresql://${CATALOG_DB_USER}:${CATALOG_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${CATALOG_DB_NAME}?schema=public

# -----------------------------------------------------------------------------
# JWT compartido (mismo secreto en auth/catalog/ticket para verificar tokens)
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Microsoft Azure AD - SSO
# Registrar la app en https://portal.azure.com -> Azure AD -> App registrations
# Redirect URI registrada: http://localhost:8080/auth/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/auth/callback
ALLOWED_DOMAIN=uta.edu.ec

# Correos que entran como admin cuando inician sesión vía Microsoft (real o simulado).
# Coma-separados. Se ignoran mayúsculas/minúsculas.
ADMIN_EMAILS=admin@uta.edu.ec

# Dev-login (POST /api/auth/dev-login) - solo para desarrollo sin Azure AD.
# Cuando es true, el frontend muestra además un botón "Entrar como admin de prueba".
# DEBE ser false en producción.
AUTH_DEV_LOGIN=true

# -----------------------------------------------------------------------------
# URLs internas (red de Docker - NO cambiar a menos que renombres servicios)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
TICKET_SERVICE_URL=http://ticket-service:3003

# -----------------------------------------------------------------------------
# API Gateway / Frontend
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# HU-15 - Notificaciones por correo (ticket-service)
# EMAIL_SEND_MODE:
#   - log  (default dev): no envía, imprime un resumen seguro.
#   - mock                : usado en tests, no envía ni imprime.
#   - smtp                : envía vía nodemailer (instalar `nodemailer` en
#                           ticket-service antes de usar este modo).
# EMAIL_NOTIFICATIONS_ENABLED=false desactiva por completo el outbox y el envío.
# Las credenciales SMTP NUNCA deben commitearse al repositorio.
# -----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_SEND_MODE=log
SMTP_FROM=ServiceDesk UTA <no-reply@uta.edu.ec>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Sprint 3+ · Almacenamiento de imágenes adjuntas (ticket-service)
# STORAGE_MODE:
#   - local (default): disco montado en el contenedor; URL relativa /uploads/xxx.
#   - cloudinary     : sube al CDN Cloudinary; URL absoluta HTTPS.
#     Requiere las 3 credenciales de abajo y `npm install cloudinary` en ticket-service.
#     Si falta el paquete o alguna credencial, cae automáticamente a `local` con warning.
# NUNCA se guardan imágenes como Base64 — la BD solo persiste la URL.
# -----------------------------------------------------------------------------
STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=servicedesk-uta
