# =============================================================================
# ServiceDesk UTA - Variables del LABORATORIO MSSQL (Fase B).
# Copiar a `.env.mssql` (NO commitear) y ajustar contraseñas.
#
# NO reemplaza `.env` (que sigue apuntando a PostgreSQL para el stack real).
# Este archivo solo se usa con `docker-compose.mssql.yml` y para conectar los
# servicios Node en modo lab contra SQL Server local.
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server 2022 (contenedor local)
# -----------------------------------------------------------------------------
# Política mínima MSSQL: >=8 chars, mayúscula+minúscula+número+símbolo.
MSSQL_SA_PASSWORD=LabSaPass!42Change

# Puerto del host donde publicar 1433. Cambiar si 14330 está ocupado.
MSSQL_HOST_PORT=14330

# -----------------------------------------------------------------------------
# 3 bases lógicas y sus credenciales dedicadas (por servicio).
# -----------------------------------------------------------------------------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=AuthLabPass!42Change

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=CatalogLabPass!42Change

TICKET_DB_NAME=ticket_db
TICKET_DB_USER=ticket_user
TICKET_DB_PASSWORD=TicketLabPass!42Change

# -----------------------------------------------------------------------------
# DATABASE_URL para los servicios Node cuando corran en modo lab MSSQL.
# El host apunta al puerto expuesto en el HOST (localhost:${MSSQL_HOST_PORT}).
# encrypt=true + trustServerCertificate=true = certificado autofirmado del lab.
# -----------------------------------------------------------------------------
AUTH_DATABASE_URL=sqlserver://localhost:14330;database=auth_db;user=auth_user;password=AuthLabPass!42Change;encrypt=true;trustServerCertificate=true
CATALOG_DATABASE_URL=sqlserver://localhost:14330;database=catalog_db;user=catalog_user;password=CatalogLabPass!42Change;encrypt=true;trustServerCertificate=true
TICKET_DATABASE_URL=sqlserver://localhost:14330;database=ticket_db;user=ticket_user;password=TicketLabPass!42Change;encrypt=true;trustServerCertificate=true
