# =============================================================================
# ServiceDesk UTA — Perfil de conexión al SQL Server INSTITUCIONAL (UTA).
#
# ⚠️  Este archivo es SÓLO UNA PLANTILLA. Nunca contiene credenciales reales.
#     Copia a `.env.uta` (que NO se commitea) y rellena con los valores que
#     proporcione el DBA de la UTA. Este archivo NO reemplaza `.env` (que
#     apunta al PostgreSQL productivo actual) ni `.env.mssql` (que apunta al
#     SQL Server de laboratorio).
#
# Uso previsto:
#   - Con el script scripts/check-uta-mssql.js para validar conectividad (RO).
#   - En la fase F (cambio productivo) para poblar el DATABASE_URL de cada
#     servicio Node cuando UTA ya haya provisto los datos.
#
# ⚠️  Reglas de seguridad:
#   - NO commitear este archivo con valores rellenos.
#   - NO copiar-pegar credenciales por chat, ticket o email en claro.
#   - El DBA UTA entrega credenciales por canal cifrado (KeePass compartido,
#     Bitwarden, mensaje 1Password, sobre USB, etc.).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Conexión al servidor SQL institucional
# -----------------------------------------------------------------------------
# Host o FQDN. Ejemplos que NO deben usarse literal: sql.uta.edu.ec, 10.0.x.x
UTA_MSSQL_HOST=
# Puerto (default 1433). El DBA puede haber elegido otro; confirmar.
UTA_MSSQL_PORT=1433
# Cifrado obligatorio en tránsito.
UTA_MSSQL_ENCRYPT=true
# Sólo se activa (=true) si el DBA confirma que el certificado del server es
# autofirmado o interno sin publicar en CAs públicas. Con cert válido → false.
UTA_MSSQL_TRUST_SERVER_CERTIFICATE=false
# Timeout de login/query en segundos (opcional; el default de Prisma va bien).
UTA_MSSQL_CONNECT_TIMEOUT=15

# -----------------------------------------------------------------------------
# 2) Credenciales
# -----------------------------------------------------------------------------
# El proyecto puede recibir dos formas de credenciales del DBA UTA:
#   A) Una sola cuenta con acceso a las 3 bases (más simple; el patrón que
#      seguimos en el laboratorio con `sa`).
#   B) Una cuenta por base (privilegio mínimo; recomendado).
#
# Si el DBA otorga la forma A, usar sólo UTA_MSSQL_USER / UTA_MSSQL_PASSWORD.
# Si otorga la forma B, dejar el bloque A vacío y completar UTA_*_USER/PASSWORD.
#
# ⚠️  En ambos casos, los valores viven SÓLO en `.env.uta` (no commiteado).

# --- Forma A: cuenta única ---
UTA_MSSQL_USER=
UTA_MSSQL_PASSWORD=

# --- Forma B: credenciales por base ---
UTA_AUTH_USER=
UTA_AUTH_PASSWORD=
UTA_CATALOG_USER=
UTA_CATALOG_PASSWORD=
UTA_TICKET_USER=
UTA_TICKET_PASSWORD=

# -----------------------------------------------------------------------------
# 3) Nombres de las 3 bases
# -----------------------------------------------------------------------------
# El DBA puede exigir prefijos (ej. `SD_AUTH`, `SERVICEDESK_AUTH_DB`). Ajustar
# aquí si difiere del default del laboratorio.
UTA_AUTH_DB=auth_db
UTA_CATALOG_DB=catalog_db
UTA_TICKET_DB=ticket_db

# -----------------------------------------------------------------------------
# 4) DSN Prisma (opcional — se puede componer en runtime, pero dejamos plantilla)
# -----------------------------------------------------------------------------
# El script `scripts/check-uta-mssql.js` puede componer estas URLs a partir de
# las variables de arriba. También pueden usarse directamente en los servicios
# Node en la Fase F. NO rellenar aquí en la plantilla — el script las arma.
# Ejemplo de forma (no usar como está — es solo referencia):
#   sqlserver://<host>:1433;database=<db>;user=<user>;password=<pw>;encrypt=true;trustServerCertificate=false
UTA_AUTH_DATABASE_URL=
UTA_CATALOG_DATABASE_URL=
UTA_TICKET_DATABASE_URL=

# -----------------------------------------------------------------------------
# 5) Otros datos que el DBA UTA puede exigir
# -----------------------------------------------------------------------------
# Nombre del schema (default `dbo`). Prisma-SQLServer soporta multi-schema como
# preview; si el DBA obliga a un schema distinto documentarlo aquí.
UTA_MSSQL_SCHEMA=dbo

# Application Name (aparece en sys.dm_exec_sessions.program_name — el DBA lo
# usa para auditoría). Recomendado: identificar el servicio y el entorno.
UTA_MSSQL_APP_NAME=ServiceDeskUTA
